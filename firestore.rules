rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // FONCTIONS UTILITAIRES DE BASE
    // =========================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data :
             null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // =========================================================================
    // FONCTIONS DE VÉRIFICATION DE RÔLE
    // =========================================================================
    
    function isSuperAdmin() {
      let userData = getUserData();
      return userData != null && (userData.status == 'superadmin' || userData.role == 'superadmin');
    }

    function isAdmin() {
      let userData = getUserData();
      return userData != null && (userData.role == 'admin' || userData.role == 'superadmin');
    }
    
    function isStructureMember(structureId) {
      let userData = getUserData();
      return userData != null && 
             userData.structureId == structureId &&
             userData.status in ['admin', 'membre'];
    }
    
    function isStructureAdmin(structureId) {
      let userData = getUserData();
      return userData != null && 
             userData.structureId == structureId &&
             userData.status == 'admin';
    }

    function canAccessStructure(structureId) {
      let userData = getUserData();
      return userData != null && userData.status in ['membre', 'admin'] && 
             userData.structureId == structureId;
    }

    function isEntreprise() {
      let userData = getUserData();
      return userData != null && userData.status == 'entreprise';
    }
    
    // =========================================================================
    // FONCTIONS DE VÉRIFICATION DE PERMISSIONS (GRANULAIRES)
    // =========================================================================
    
    // Vérifie si l'utilisateur a une permission de module spécifique
    // permissionId: 'tresorerie', 'tresorerie_read', 'rh', 'rh_read', 'commercial', etc.
    // Note: La vérification des pôles se fait via allowedRoles pour simplifier
    function hasModulePermission(structureId, permissionId) {
      let userData = getUserData();
      let permissionPath = /databases/$(database)/documents/structures/$(structureId)/permissions/$(permissionId);
      
      // Superadmin a toujours accès
      return isSuperAdmin() ||
             (
               // L'utilisateur doit appartenir à la structure
               userData != null &&
               userData.structureId == structureId &&
               userData.status in ['admin', 'membre'] &&
               // Vérifier si la permission existe
               exists(permissionPath) &&
               (
                 // Vérifier si le rôle de l'utilisateur est autorisé
                 (get(permissionPath).data.allowedRoles != null && 
                  get(permissionPath).data.allowedRoles.hasAny([userData.status])) ||
                 // Vérifier si l'utilisateur est explicitement autorisé
                 (get(permissionPath).data.allowedMembers != null &&
                  get(permissionPath).data.allowedMembers.hasAny([request.auth.uid]))
               )
             );
    }
    
    // Vérifie si l'utilisateur a au moins la permission de lecture sur un module
    function hasReadPermission(structureId, moduleId) {
      return isSuperAdmin() ||
             isStructureAdmin(structureId) ||
             hasModulePermission(structureId, moduleId) ||
             hasModulePermission(structureId, moduleId + '_read');
    }
    
    // Vérifie si l'utilisateur a la permission d'écriture sur un module
    function hasWritePermission(structureId, moduleId) {
      return isSuperAdmin() ||
             isStructureAdmin(structureId) ||
             hasModulePermission(structureId, moduleId);
    }
    
    // =========================================================================
    // FONCTION RBAC PRINCIPALE - hasPermission (max 10 variables par fonction)
    // =========================================================================
    
    // Helper pour réduire le nombre de variables dans hasPermission
    function hasRoleOrMemberAccess(permissionExists, permissionData, effectiveStatus) {
      let roleOk = permissionExists && permissionData != null && effectiveStatus != null && permissionData.allowedRoles != null &&
        (permissionData.allowedRoles.hasAny([effectiveStatus]) ||
         (effectiveStatus == 'membre' && permissionData.allowedRoles.hasAny(['member'])) ||
         (effectiveStatus == 'member' && permissionData.allowedRoles.hasAny(['membre'])));
      let memberOk = permissionExists && permissionData != null && permissionData.allowedMembers != null && permissionData.allowedMembers.hasAny([request.auth.uid]);
      return roleOk || memberOk;
    }
    
    // Accès par pôle : l'utilisateur a poleIds (liste d'ids) et le doc permission a allowedPoles.
    function hasPoleAccess(permissionExists, permissionData, userData) {
      return permissionExists && permissionData != null && permissionData.allowedPoles != null &&
             userData != null && userData.poleIds != null && userData.poleIds.hasAny(permissionData.allowedPoles);
    }
    
    function hasPermission(pageId, accessType) {
      let userData = getUserData();
      let hasUserData = userData != null;
      let effectiveStatus = hasUserData && userData.status != null && userData.status != '' ? userData.status : (hasUserData && userData.role != null ? userData.role : null);
      // Seul le superadmin contourne les permissions. L'admin de structure est soumis aux docs Réglages > Accès.
      let isPrivileged = hasUserData && (effectiveStatus == 'superadmin' || userData.role == 'superadmin');
      let docId = accessType == 'read' ? pageId + '_read' : pageId;
      let structureId = hasUserData ? userData.structureId : null;
      let permissionPath = structureId != null ? /databases/$(database)/documents/structures/$(structureId)/permissions/$(docId) : null;
      let permissionExists = structureId != null && permissionPath != null && exists(permissionPath);
      let permissionData = permissionExists ? get(permissionPath).data : null;
      let roleOrMember = hasRoleOrMemberAccess(permissionExists, permissionData, effectiveStatus);
      let poleOk = hasPoleAccess(permissionExists, permissionData, userData);
      return isPrivileged || roleOrMember || poleOk;
    }
    
    // Wrapper pour vérifier l'accès en lecture
    function canReadPage(pageId) {
      return hasPermission(pageId, 'read') || hasPermission(pageId, 'write');
    }
    
    // Wrapper pour vérifier l'accès en écriture  
    function canWritePage(pageId) {
      return hasPermission(pageId, 'write');
    }
    
    // Accès selon les documents de permission (Réglages > Accès). Seul le superadmin contourne.
    function hasPermissionOrStructureFallback(pageId, accessType, resourceStructureId) {
      let userData = getUserData();
      let validInputs = userData != null && resourceStructureId != null && resourceStructureId != '';
      let sameStructure = validInputs && userData.structureId == resourceStructureId;
      return hasPermission(pageId, accessType) || (sameStructure && isSuperAdmin());
    }
    
    // =========================================================================
    // FONCTIONS D'ACCÈS AUX DOCUMENTS/DOSSIERS RESTREINTS
    // =========================================================================
    
    // Fonction pour vérifier si un contact est de type entreprise
    function isEnterpriseCreatingOwnMission() {
      let userData = getUserData();
      return userData != null &&
             userData.status == 'entreprise' && 
             request.resource.data.companyId == request.auth.uid &&
             request.resource.data.createdByEnterprise == true;
    }
    
    function isContactCreatingEvent() {
      let userData = getUserData();
      return userData != null &&
             userData.status == 'entreprise' &&
             userData.companyId != null &&
             request.resource.data.type == 'ambassadeur_event' &&
             request.resource.data.companyId == userData.companyId;
    }
    
    function isEnterpriseAccessingOwnMission() {
      let userData = getUserData();
      return resource.data.companyId == request.auth.uid &&
             userData != null &&
             userData.status == 'entreprise';
    }

    // =========================================================================
    // RÈGLES POUR LA COLLECTION MISSIONS
    // =========================================================================
    
    match /missions/{missionId} {
      function canAccessMission() {
        let userData = getUserData();
        return isSuperAdmin() ||
               resource.data.companyId == request.auth.uid ||
               (
                 userData != null &&
                 userData.status in ['admin', 'membre'] &&
                 userData.structureId != null &&
                 userData.structureId != '' &&
                 resource.data.structureId != null &&
                 resource.data.structureId != '' &&
                 resource.data.structureId == userData.structureId
               );
      }
      
      function canAccessViaStructure() {
        return resource.data.structureId != null && resource.data.structureId != '' &&
               hasPermissionOrStructureFallback('mission', 'read', resource.data.structureId);
      }
      
      // Lecture missions autorisée aussi avec permission Audit (page Audit)
      function canAccessViaAudit() {
        return resource.data.structureId != null && resource.data.structureId != '' &&
               hasPermissionOrStructureFallback('audit', 'read', resource.data.structureId);
      }
      
      function canWriteViaStructure() {
        return resource.data.structureId != null && resource.data.structureId != '' &&
               hasPermissionOrStructureFallback('mission', 'write', resource.data.structureId);
      }
      
      function canCreateViaStructure() {
        return request.resource.data.structureId != null && request.resource.data.structureId != '' &&
               hasPermissionOrStructureFallback('mission', 'write', request.resource.data.structureId);
      }
      
      function canAccessAsStudent() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'etudiant' &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.structureId != null &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.structureId != '' &&
               resource.data.structureId != null &&
               resource.data.structureId != '' &&
               resource.data.structureId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.structureId &&
               resource.data.isPublished == true;
      }
      
      function canAccessMissionAsStudent() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'etudiant' &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.structureId != null &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.structureId != '' &&
               resource.data.structureId != null &&
               resource.data.structureId != '' &&
               resource.data.structureId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.structureId;
      }
      
      function canAccessAsContactWithAccess() {
        let userData = getUserData();
        return userData != null &&
               userData.status == 'entreprise' &&
               userData.companyId != null &&
               resource.data.companyId == userData.companyId;
      }
      
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.companyId == request.auth.uid ||
        canAccessMission() ||
        canAccessViaStructure() ||
        canAccessViaAudit() ||
        canAccessAsStudent() ||
        canAccessMissionAsStudent() ||
        canAccessAsContactWithAccess()
      );
      
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        canCreateViaStructure() ||
        isEnterpriseCreatingOwnMission() ||
        isContactCreatingEvent()
      );
      
      function canContactUpdateEvent() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'entreprise' &&
               resource.data.type == 'ambassadeur_event' &&
               request.resource.data.type == 'ambassadeur_event';
      }
      
      function canContactUpdateSlots() {
        let userData = getUserData();
        return userData != null &&
               userData.status == 'entreprise' &&
               userData.companyId != null &&
               resource.data.type == 'ambassadeur_event' &&
               resource.data.companyId == userData.companyId &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots', 'updatedAt']);
      }
      
      function canContactUpdateVisibility() {
        let userData = getUserData();
        return userData != null &&
               userData.status == 'entreprise' &&
               userData.companyId != null &&
               resource.data.type == 'ambassadeur_event' &&
               resource.data.companyId == userData.companyId &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibleForAmbassadors', 'updatedAt']);
      }
      
      function canContactUpdateEventFields() {
        return canContactUpdateEvent();
      }
      
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        canWriteViaStructure() ||
        (
          isEntreprise() &&
          resource.data.companyId == request.auth.uid &&
          resource.data.createdByEnterprise == true &&
          request.resource.data.structureId == resource.data.structureId &&
          request.resource.data.numeroMission == resource.data.numeroMission &&
          request.resource.data.companyId == resource.data.companyId
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'entreprise' &&
          resource.data.type == 'ambassadeur_event' &&
          request.resource.data.type == 'ambassadeur_event'
        ) ||
        canContactUpdateEvent() ||
        canContactUpdateSlots() ||
        canContactUpdateVisibility() ||
        canContactUpdateEventFields()
      );
      
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        canWriteViaStructure()
      );

      // Sous-collection generatedDocuments (missionId = missionId du parent)
      match /generatedDocuments/{documentId} {
        function isDocumentStudent() {
          let docData = resource.data;
          return docData.applicationId != null &&
                 exists(/databases/$(database)/documents/applications/$(docData.applicationId)) &&
                 get(/databases/$(database)/documents/applications/$(docData.applicationId)).data.userId == request.auth.uid;
        }
        
        function getDocStructureId(docData) {
          return docData.structureId != null && docData.structureId != '' ? docData.structureId : (docData.missionId != null && exists(/databases/$(database)/documents/missions/$(docData.missionId)) ? get(/databases/$(database)/documents/missions/$(docData.missionId)).data.structureId : (exists(/databases/$(database)/documents/missions/$(missionId)) ? get(/databases/$(database)/documents/missions/$(missionId)).data.structureId : null));
        }
        
        function canAccessViaStructure() {
          let docData = resource.data;
          let structureId = getDocStructureId(docData);
          return structureId != null && structureId != '' &&
                 (hasPermissionOrStructureFallback('mission', 'read', structureId) ||
                  hasPermissionOrStructureFallback('tresorerie', 'read', structureId));
        }
        
        function canWriteViaStructure() {
          let docData = resource.data;
          let structureId = getDocStructureId(docData);
          return structureId != null && structureId != '' &&
                 hasPermissionOrStructureFallback('mission', 'write', structureId);
        }
        
        function canCreateViaStructure() {
          let docData = request.resource.data;
          return docData.structureId != null && docData.structureId != '' &&
                 hasPermissionOrStructureFallback('mission', 'write', docData.structureId);
        }
        
        function canAccessAsContactWithAccess() {
          let userData = getUserData();
          let docData = resource.data;
          return userData != null &&
                 userData.status == 'entreprise' &&
                 userData.companyId != null &&
                 docData.missionId != null &&
                 exists(/databases/$(database)/documents/missions/$(docData.missionId)) &&
                 get(/databases/$(database)/documents/missions/$(docData.missionId)).data.companyId == userData.companyId;
        }
        
        allow read: if isAuthenticated() && (
          isSuperAdmin() ||
          isDocumentStudent() ||
          canAccessViaStructure() ||
          canAccessAsContactWithAccess()
        );
        
        allow create: if isAuthenticated() && (
          isSuperAdmin() ||
          canCreateViaStructure()
        );
        
        allow update: if isAuthenticated() && (
          isSuperAdmin() ||
          canWriteViaStructure()
        );
        
        allow delete: if isAuthenticated() && (
          isSuperAdmin() ||
          canWriteViaStructure()
        );
      }
    }

    // =========================================================================
    // RÈGLES POUR LA COLLECTION COMPANIES
    // =========================================================================
    
    match /companies/{companyId} {
      function canAccessAsContactWithAccess() {
        let userData = getUserData();
        return userData != null &&
               userData.status == 'entreprise' &&
               userData.companyId != null &&
               resource.id == userData.companyId;
      }
      
      // Admin/membre : accepter status OU role (compatibilité)
      function isAdminOrMember(userData) {
        return userData.status == 'admin' || userData.status == 'membre' ||
               userData.role == 'admin' || userData.role == 'superadmin';
      }
      
      function canReadCompanies() {
        let userData = getUserData();
        return userData != null && 
               userData.structureId != null &&
               userData.structureId == resource.data.structureId &&
               (isSuperAdmin() || isAdminOrMember(userData));
      }
      
      function canWriteCompanies() {
        let userData = getUserData();
        return userData != null && 
               userData.structureId != null &&
               userData.structureId == resource.data.structureId &&
               (isSuperAdmin() || isAdminOrMember(userData));
      }
      
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        canReadCompanies() ||
        canAccessAsContactWithAccess()
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        canWriteCompanies() ||
        canAccessAsContactWithAccess()
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          getUserData() != null &&
          getUserData().structureId != null &&
          request.resource.data.structureId == getUserData().structureId &&
          (isSuperAdmin() || isAdminOrMember(getUserData()))
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || 
        canWriteCompanies()
      );
    }

    // =========================================================================
    // RÈGLES POUR LES DESCRIPTIONS ET TYPES DE MISSION
    // =========================================================================
    
    match /descriptions/{descriptionId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.structureId == getUserData().structureId
      );
      allow write: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          request.resource.data.structureId == getUserData().structureId &&
          getUserData().status in ['membre', 'admin']
        )
      );
    }

    match /missionTypes/{missionTypeId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.structureId == getUserData().structureId
      );
      allow write: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          request.resource.data.structureId == getUserData().structureId &&
          getUserData().status in ['membre', 'admin']
        )
      );
    }

    // Paramètres de notation IA (scoring) par structure
    match /scoringSettings/{settingsId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.structureId == getUserData().structureId
      );
      allow create, update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.resource.data.structureId == getUserData().structureId &&
          (getUserData().status in ['membre', 'admin', 'admin_structure', 'etudiant'])
        )
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          resource.data.structureId == getUserData().structureId &&
          (getUserData().status in ['membre', 'admin', 'admin_structure'])
        )
      );
    }

    // =========================================================================
    // RÈGLES POUR LA COLLECTION APPLICATIONS
    // =========================================================================
    
    match /applications/{applicationId} {
      function canAccessViaMission() {
        let applicationData = resource.data;
        return applicationData.userId == request.auth.uid ||
               (
                 exists(/databases/$(database)/documents/missions/$(applicationData.missionId)) &&
                 (
                   isSuperAdmin() ||
                   hasPermissionOrStructureFallback('mission', 'read', get(/databases/$(database)/documents/missions/$(applicationData.missionId)).data.structureId) ||
                   hasPermissionOrStructureFallback('tresorerie', 'read', get(/databases/$(database)/documents/missions/$(applicationData.missionId)).data.structureId)
                 )
               );
      }
      
      function canWriteApplicationViaMission() {
        let applicationData = resource.data;
        return exists(/databases/$(database)/documents/missions/$(applicationData.missionId)) &&
               (isSuperAdmin() ||
                hasPermissionOrStructureFallback('mission', 'write', get(/databases/$(database)/documents/missions/$(applicationData.missionId)).data.structureId));
      }
      
      function canCreateApplicationViaMission() {
        let applicationData = request.resource.data;
        return exists(/databases/$(database)/documents/missions/$(applicationData.missionId)) &&
               (isSuperAdmin() ||
                hasPermissionOrStructureFallback('mission', 'write', get(/databases/$(database)/documents/missions/$(applicationData.missionId)).data.structureId));
      }
      
      function canAccessAsContactWithAccess() {
        let userData = getUserData();
        let applicationData = resource.data;
        return userData != null &&
               userData.status == 'entreprise' &&
               userData.companyId != null &&
               exists(/databases/$(database)/documents/missions/$(applicationData.missionId)) &&
               get(/databases/$(database)/documents/missions/$(applicationData.missionId)).data.companyId == userData.companyId;
      }

      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        canAccessViaMission() ||
        canAccessAsContactWithAccess()
      );

      function canCreateAsContactWithAccess() {
        let userData = getUserData();
        let applicationData = request.resource.data;
        return userData != null &&
               userData.status == 'entreprise' &&
               userData.companyId != null &&
               exists(/databases/$(database)/documents/missions/$(applicationData.missionId)) &&
               get(/databases/$(database)/documents/missions/$(applicationData.missionId)).data.companyId == userData.companyId &&
               get(/databases/$(database)/documents/missions/$(applicationData.missionId)).data.type == 'ambassadeur_event' &&
               applicationData.keys().hasAll(['missionId', 'userId', 'userEmail', 'submittedAt', 'status']) &&
               applicationData.status in ['En attente', 'Acceptée'];
      }

      allow create: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid &&
         request.resource.data.keys().hasAll(['missionId', 'userId', 'userEmail', 'submittedAt', 'status']) &&
         request.resource.data.status == 'En attente') ||
        canCreateAsContactWithAccess() ||
        canCreateApplicationViaMission()
      );

      function canUpdateAsContactWithAccess() {
        let userData = getUserData();
        let applicationData = resource.data;
        return userData != null &&
               userData.status == 'entreprise' &&
               userData.companyId != null &&
               exists(/databases/$(database)/documents/missions/$(applicationData.missionId)) &&
               get(/databases/$(database)/documents/missions/$(applicationData.missionId)).data.companyId == userData.companyId &&
               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
               request.resource.data.status in ['En attente', 'Acceptée', 'Refusée'];
      }
      
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        canWriteApplicationViaMission() ||
        canUpdateAsContactWithAccess()
      );

      allow delete: if false;
    }

    // =========================================================================
    // RÈGLES POUR LA COLLECTION USERS
    // =========================================================================
    
    match /users/{userId} {
      allow create: if request.auth == null || request.auth.uid == userId;
      
      // Permettre la mise à jour par l'utilisateur lui-même, le superadmin, l'admin de la structure, ou un membre avec permission organisation (écriture)
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (
          getUserData().status == 'admin' &&
          resource.data.structureId == getUserData().structureId
        ) ||
        (
          getUserData() != null &&
          resource.data.structureId == getUserData().structureId &&
          hasPermission('organization', 'write')
        )
      );
      
      function canContactReadUser() {
        let userData = getUserData();
        return userData != null &&
               userData.status == 'entreprise' &&
               userData.companyId != null &&
               resource.data.status == 'etudiant';
      }
      
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        isSuperAdmin() ||
        (resource.data.structureId == getUserData().structureId) ||
        canContactReadUser() ||
        (request.auth.uid != null)
      );
      
      allow delete: if false;
    }

    // =========================================================================
    // RÈGLES POUR LA COLLECTION STRUCTURES
    // =========================================================================
    
    match /structures/{structureId} {
      allow read: if true;
      allow create: if isAuthenticated() && isSuperAdmin();
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (getUserData() != null && getUserData().structureId == structureId && hasPermission('organization', 'write'))
      );
      allow delete: if isAuthenticated() && isSuperAdmin();

      // Sous-collection permissions
      match /permissions/{permissionId} {
        function canReadPermissions() {
          let userData = getUserData();
          return userData != null &&
                 userData.status in ['admin', 'membre'] &&
                 userData.structureId == structureId;
        }
        
        function canWritePermissions() {
          let userData = getUserData();
          return userData != null &&
                 userData.status == 'admin' &&
                 userData.structureId == structureId;
        }
        
        allow read: if isAuthenticated() && (
          isSuperAdmin() || 
          canReadPermissions()
        );
        allow write: if isAuthenticated() && (
          isSuperAdmin() || 
          canWritePermissions()
        );
      }

      // Sous-collection folders (dossiers de documents)
      match /folders/{folderId} {
        // L'utilisateur peut accéder si il appartient à la structure (via le path)
        function canAccessFolder() {
          let userData = getUserData();
          return userData != null && 
                 userData.structureId != null &&
                 userData.structureId != '' &&
                 userData.structureId == structureId;
        }

        // FONCTION CORRIGÉE pour l'accès aux dossiers restreints
        function canAccessRestrictedFolder() {
          let userData = getUserData();
          let folderData = resource.data;
          return canAccessFolder() && (
            // Si le dossier n'est pas restreint, l'accès est autorisé
            folderData.isRestricted != true ||
            // Sinon, vérifier les permissions
            isSuperAdmin() ||
            userData.status == 'admin' ||
            (
              folderData.allowedRoles != null && 
              folderData.allowedRoles.hasAny([userData.status])
            )
          );
        }

        allow read: if isAuthenticated() && (
          isSuperAdmin() ||
          canAccessRestrictedFolder()
        );

        allow create: if isAuthenticated() && (
          isSuperAdmin() ||
          (
            getUserData().status in ['admin', 'membre'] && 
            getUserData().structureId == structureId
          )
        );

        allow update: if isAuthenticated() && (
          isSuperAdmin() ||
          (
            getUserData().status in ['admin', 'membre'] && 
            getUserData().structureId == structureId
          )
        );

        allow delete: if isAuthenticated() && (
          isSuperAdmin() ||
          (
            getUserData().status in ['admin', 'membre'] && 
            getUserData().structureId == structureId
          )
        );
      }

      // Sous-collection folderColors (couleurs personnalisées des dossiers)
      match /folderColors/{colorId} {
        allow read: if isAuthenticated() && (
          isSuperAdmin() ||
          getUserData().structureId == structureId
        );
        
        allow write: if isAuthenticated() && (
          isSuperAdmin() ||
          (
            getUserData().status in ['admin', 'membre'] && 
            getUserData().structureId == structureId
          )
        );
      }

      // Sous-collection documents (métadonnées de documents)
      match /documents/{documentId} {
        // L'utilisateur peut accéder si il appartient à la structure (via le path)
        function canAccessDocument() {
          let userData = getUserData();
          return userData != null && 
                 userData.structureId != null &&
                 userData.structureId != '' &&
                 userData.structureId == structureId;
        }

        // FONCTION CORRIGÉE pour l'accès aux documents restreints
        function canAccessRestrictedDocument() {
          let userData = getUserData();
          let docData = resource.data;
          return canAccessDocument() && (
            // Si le document n'est pas restreint, l'accès est autorisé
            docData.isRestricted != true ||
            // Sinon, vérifier les permissions
            isSuperAdmin() ||
            userData.status == 'admin' ||
            (
              docData.allowedRoles != null && 
              docData.allowedRoles.hasAny([userData.status])
            )
          );
        }

        allow read: if isAuthenticated() && (
          isSuperAdmin() ||
          canAccessRestrictedDocument()
        );

        allow create: if isAuthenticated() && (
          isSuperAdmin() ||
          (
            getUserData().status in ['admin', 'membre'] && 
            getUserData().structureId == structureId
          )
        );

        allow update: if isAuthenticated() && (
          isSuperAdmin() ||
          (
            getUserData().status in ['admin', 'membre'] && 
            getUserData().structureId == structureId
          )
        );

        allow delete: if isAuthenticated() && (
          isSuperAdmin() ||
          (
            getUserData().status in ['admin', 'membre'] && 
            getUserData().structureId == structureId
          )
        );
      }
    }

    // =========================================================================
    // RÈGLES POUR LES RAPPORTS
    // =========================================================================
    
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // RÈGLES POUR LES ÉVÉNEMENTS CALENDRIER
    // =========================================================================
    
    match /calendarEvents/{eventId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.structureId == getUserData().structureId
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          request.resource.data.structureId == getUserData().structureId &&
          getUserData().status in ['membre', 'admin']
        )
      );
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          resource.data.structureId == getUserData().structureId &&
          getUserData().status in ['membre', 'admin']
        )
      );
    }

    // =========================================================================
    // RÈGLES POUR LES TEMPLATES
    // =========================================================================
    
    match /templates/{templateId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isSuperAdmin() || canWritePage('mission'));
      allow update: if isAuthenticated() && (isSuperAdmin() || canWritePage('mission'));
      allow delete: if isAuthenticated() && (isSuperAdmin() || canWritePage('mission'));
    }

    match /quoteTemplates/{templateId} {
      function canAccessQuoteTemplate() {
        let userData = getUserData();
        return userData != null &&
               resource.data.structureId == userData.structureId &&
               (userData.status in ['admin', 'membre'] || userData.role in ['admin', 'superadmin'] || userData.status == 'superadmin');
      }
      allow read, write: if isAuthenticated() && (isSuperAdmin() || canAccessQuoteTemplate());
    }

    // Lecture ouverte à tout utilisateur authentifié pour la génération de documents
    match /templateAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.resource.data.structureId == getUserData().structureId && hasPermissionOrStructureFallback('mission', 'write', request.resource.data.structureId))
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.structureId == getUserData().structureId && hasPermissionOrStructureFallback('mission', 'write', resource.data.structureId))
      );
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.structureId == getUserData().structureId && hasPermissionOrStructureFallback('mission', 'write', resource.data.structureId))
      );
    }

    match /templateVariables/{variableId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /documentTags/{tagId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /defaultTemplateAssignments/{documentType} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // RÈGLES POUR LES PROGRAMMES
    // =========================================================================
    
    match /programs/{structureId} {
      allow read: if true;
      allow write: if isAuthenticated() && isSuperAdmin();
    }

    // =========================================================================
    // RÈGLES POUR LES TOKENS DE STRUCTURE
    // =========================================================================
    
    match /structureTokens/{structureId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        getUserData().structureId == structureId
      );
      allow create: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          request.resource.data.structureId == structureId &&
          getUserData() != null &&
          getUserData().structureId == structureId &&
          (getUserData().status in ['admin', 'membre'] || getUserData().role in ['admin', 'membre'])
        )
      );
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          resource.data.structureId == structureId &&
          getUserData() != null &&
          getUserData().structureId == structureId &&
          (getUserData().status in ['admin', 'membre'] || getUserData().role in ['admin', 'membre'])
        )
      );
      allow delete: if false;
    }

    // =========================================================================
    // RÈGLES POUR LES PROSPECTS (COMMERCIAL) - AVEC VÉRIFICATION PERMISSIONS
    // =========================================================================
    
    match /prospects/{prospectId} {
      // Vérification d'accès incluant les permissions du module commercial
      function canAccessProspect() {
        let userData = getUserData();
        return isSuperAdmin() ||
               (
                 userData != null &&
                 resource.data.structureId == userData.structureId &&
                 userData.status in ['admin', 'membre']
               );
      }
      
      allow read: if isAuthenticated() && canAccessProspect();
      
      allow create: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          request.resource.data.structureId == getUserData().structureId &&
          getUserData().status in ['membre', 'admin']
        )
      );
      
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          resource.data.structureId == getUserData().structureId &&
          getUserData().status in ['membre', 'admin']
        )
      );
      
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          resource.data.structureId == getUserData().structureId &&
          getUserData().status in ['membre', 'admin']
        )
      );

      // Sous-collection activities
      match /activities/{activityId} {
        allow read: if isAuthenticated() && (
          isSuperAdmin() || 
          get(/databases/$(database)/documents/prospects/$(prospectId)).data.structureId == getUserData().structureId
        );
        allow create: if isAuthenticated() && (
          isSuperAdmin() || 
          (
            get(/databases/$(database)/documents/prospects/$(prospectId)).data.structureId == getUserData().structureId &&
            getUserData().status in ['membre', 'admin']
          )
        );
        allow update: if isAuthenticated() && (
          isSuperAdmin() || 
          (
            get(/databases/$(database)/documents/prospects/$(prospectId)).data.structureId == getUserData().structureId &&
            getUserData().status in ['membre', 'admin']
          )
        );
        allow delete: if isAuthenticated() && (
          isSuperAdmin() || 
          (
            get(/databases/$(database)/documents/prospects/$(prospectId)).data.structureId == getUserData().structureId &&
            getUserData().status == 'admin'
          )
        );
      }
    }

    // =========================================================================
    // RÈGLES POUR LES CONTRACTS (TRÉSORERIE) - AVEC VÉRIFICATION PERMISSIONS
    // =========================================================================
    
    match /contracts/{contractId} {
      // Fonction simplifiée - la vérification fine des pôles se fait dans ProtectedRoute
      // Ici on vérifie juste que l'utilisateur appartient à la structure
      function canReadContract() {
        let userData = getUserData();
        let structureId = resource.data.structureId;
        
        return isSuperAdmin() ||
               (
                 userData != null &&
                 userData.status in ['admin', 'membre'] &&
                 structureId == userData.structureId
               );
      }
      
      // Fonction pour vérifier l'accès en écriture aux contrats
      function canWriteContract() {
        let userData = getUserData();
        
        return isSuperAdmin() ||
               (
                 userData != null &&
                 userData.status in ['admin', 'membre'] &&
                 resource.data.structureId == userData.structureId
               );
      }
      
      allow read: if isAuthenticated() && canReadContract();
      allow write: if isAuthenticated() && canWriteContract();
    }

    // =========================================================================
    // RÈGLES POUR LES TÂCHES DE RECRUTEMENT
    // =========================================================================
    
    match /recruitmentTasks/{taskId} {
      function canAccessTask() {
        let userData = getUserData();
        return isSuperAdmin() ||
               (resource.data.isPublished == true && resource.data.isPublic == true) ||
               (userData != null &&
                userData.status in ['admin', 'membre'] && 
                resource.data.structureId != null &&
                resource.data.structureId == userData.structureId);
      }
      
      allow read: if isAuthenticated() && canAccessTask();
      
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (getUserData().status in ['admin', 'membre'] &&
         request.resource.data.structureId == getUserData().structureId)
      );
      
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (getUserData().status in ['admin', 'membre'] &&
         resource.data.structureId == getUserData().structureId)
      );
      
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (getUserData().status in ['admin', 'membre'] &&
         resource.data.structureId == getUserData().structureId)
      );
    }

    // =========================================================================
    // RÈGLES POUR LES INVITATIONS AMBASSADEUR
    // =========================================================================
    
    match /ambassadorInvites/{inviteId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (getUserData() != null && (
          resource.data.structureId == getUserData().structureId ||
          resource.data.invitedBy == request.auth.uid
        ))
      );
      allow update: if false;
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (getUserData() != null && (
          resource.data.structureId == getUserData().structureId ||
          resource.data.invitedBy == request.auth.uid
        ))
      );
    }

    // =========================================================================
    // RÈGLES POUR LES ÉTUDES
    // =========================================================================
    
    match /etudes/{etudeId} {
      function canAccessEtude() {
        let userData = getUserData();
        return isSuperAdmin() ||
               (resource.data.isPublic == true) ||
               (userData != null &&
                userData.status in ['admin', 'membre'] && 
                resource.data.structureId != null &&
                resource.data.structureId == userData.structureId);
      }
      
      allow read: if isAuthenticated() && canAccessEtude();
      
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (getUserData().status in ['admin', 'membre'] &&
         request.resource.data.structureId == getUserData().structureId)
      );
      
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (getUserData().status in ['admin', 'membre'] &&
         resource.data.structureId == getUserData().structureId)
      );
      
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (getUserData().status in ['admin', 'membre'] &&
         resource.data.structureId == getUserData().structureId)
      );
    }

    // =========================================================================
    // RÈGLES POUR L'HISTORIQUE (LOGS D'ACTIVITÉ)
    // =========================================================================
    
    match /history/{historyId} {
      function canAccessHistory() {
        let userData = getUserData();
        return isSuperAdmin() ||
               (userData != null &&
                userData.status in ['admin', 'membre']);
      }
      
      allow read: if isAuthenticated() && canAccessHistory();
      allow create: if isAuthenticated() && canAccessHistory();
      allow update: if isAuthenticated() && canAccessHistory();
      allow delete: if isAuthenticated() && isSuperAdmin();
    }

    // =========================================================================
    // RÈGLES POUR LES NOTIFICATIONS
    // =========================================================================
    
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // =========================================================================
    // RÈGLES POUR LES ABONNEMENTS ET PAIEMENTS
    // =========================================================================
    
    match /subscriptions/{subscriptionId} {
      function canAccessSubscription() {
        let userData = getUserData();
        return (subscriptionId == request.auth.uid) ||
               isSuperAdmin() ||
               (userData != null &&
                (userData.status == 'admin' || userData.status == 'membre' || userData.role == 'admin') &&
                (subscriptionId == userData.structureId ||
                 (resource.data.structureId != null && resource.data.structureId == userData.structureId)));
      }
      
      allow read: if isAuthenticated() && canAccessSubscription();
      
      allow create: if isAuthenticated() && (
        isSuperAdmin() || 
        (subscriptionId == request.auth.uid) ||
        (request.resource.data.structureId == getUserData().structureId &&
         getUserData().status == 'admin')
      );
      
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (subscriptionId == request.auth.uid) ||
        (resource.data.structureId == getUserData().structureId &&
         getUserData().status == 'admin')
      );
      
      allow delete: if isSuperAdmin();
    }

    match /stripeCustomers/{customerId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        resource.data.structureId == getUserData().structureId &&
        getUserData().status == 'admin'
      );
      allow write: if isAuthenticated() && (
        isSuperAdmin() || 
        request.resource.data.structureId == getUserData().structureId &&
        getUserData().status == 'admin'
      );
    }

    // =========================================================================
    // RÈGLES POUR LES NOTES
    // =========================================================================
    
    match /notes/{noteId} {
      function getNoteMissionStructureId() {
        let noteData = resource.data;
        return exists(/databases/$(database)/documents/missions/$(noteData.missionId)) ?
               get(/databases/$(database)/documents/missions/$(noteData.missionId)).data.structureId : null;
      }
      function isSameStructureMember(sid) {
        let userData = getUserData();
        return userData != null && userData.structureId == sid && userData.status in ['admin', 'membre'];
      }
      function canReadNote() {
        let noteData = resource.data;
        let sid = getNoteMissionStructureId();
        return resource.data.createdBy == request.auth.uid ||
               (isEntreprise() && exists(/databases/$(database)/documents/missions/$(noteData.missionId)) &&
                get(/databases/$(database)/documents/missions/$(noteData.missionId)).data.companyId == request.auth.uid) ||
               (sid != null && (isSameStructureMember(sid) || hasPermissionOrStructureFallback('mission', 'read', sid) || hasPermissionOrStructureFallback('audit', 'read', sid)));
      }
      function canWriteNote() {
        let noteData = resource.data;
        let sid = getNoteMissionStructureId();
        return (sid != null && (isSameStructureMember(sid) || hasPermissionOrStructureFallback('mission', 'write', sid) || hasPermissionOrStructureFallback('audit', 'write', sid))) ||
               (isEntreprise() && exists(/databases/$(database)/documents/missions/$(noteData.missionId)) &&
                get(/databases/$(database)/documents/missions/$(noteData.missionId)).data.companyId == request.auth.uid) ||
               resource.data.createdBy == request.auth.uid;
      }
      allow read: if isAuthenticated() && (isSuperAdmin() || canReadNote());
      function canCreateNoteForMission(mid) {
        return mid != null && exists(/databases/$(database)/documents/missions/$(mid)) &&
         (isSameStructureMember(get(/databases/$(database)/documents/missions/$(mid)).data.structureId) ||
          hasPermissionOrStructureFallback('mission', 'write', get(/databases/$(database)/documents/missions/$(mid)).data.structureId) ||
          hasPermissionOrStructureFallback('audit', 'write', get(/databases/$(database)/documents/missions/$(mid)).data.structureId));
      }
      allow create: if isAuthenticated() && (isSuperAdmin() || canCreateNoteForMission(request.resource.data.missionId));
      allow update: if isAuthenticated() && (isSuperAdmin() || canWriteNote());
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        canWriteNote()
      );
    }

    // =========================================================================
    // RÈGLES POUR LES NOTES DE FRAIS
    // =========================================================================
    
    match /expenseNotes/{expenseNoteId} {
      function getExpenseNoteMissionStructureId() {
        let expenseNoteData = resource.data;
        return exists(/databases/$(database)/documents/missions/$(expenseNoteData.missionId)) ?
               get(/databases/$(database)/documents/missions/$(expenseNoteData.missionId)).data.structureId : null;
      }
      function canReadExpenseNote() {
        let expenseNoteData = resource.data;
        let sid = getExpenseNoteMissionStructureId();
        return resource.data.createdBy == request.auth.uid ||
               (isEntreprise() && exists(/databases/$(database)/documents/missions/$(expenseNoteData.missionId)) &&
                get(/databases/$(database)/documents/missions/$(expenseNoteData.missionId)).data.companyId == request.auth.uid) ||
               (sid != null && (hasPermissionOrStructureFallback('mission', 'read', sid) || hasPermissionOrStructureFallback('tresorerie', 'read', sid)));
      }
      function canWriteExpenseNote() {
        let expenseNoteData = resource.data;
        return (getExpenseNoteMissionStructureId() != null && hasPermissionOrStructureFallback('mission', 'write', getExpenseNoteMissionStructureId())) ||
               (isEntreprise() && exists(/databases/$(database)/documents/missions/$(expenseNoteData.missionId)) &&
                get(/databases/$(database)/documents/missions/$(expenseNoteData.missionId)).data.companyId == request.auth.uid) ||
               resource.data.createdBy == request.auth.uid;
      }
      allow read: if isAuthenticated() && (isSuperAdmin() || canReadExpenseNote());
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.resource.data.missionId != null && exists(/databases/$(database)/documents/missions/$(request.resource.data.missionId)) &&
         hasPermissionOrStructureFallback('mission', 'write', get(/databases/$(database)/documents/missions/$(request.resource.data.missionId)).data.structureId))
      );
      allow update: if isAuthenticated() && (isSuperAdmin() || canWriteExpenseNote());
      allow delete: if isAuthenticated() && (isSuperAdmin() || canWriteExpenseNote());
    }

    // =========================================================================
    // RÈGLES POUR LES HEURES DE TRAVAIL
    // =========================================================================
    
    match /workingHours/{workingHourId} {
      function getWorkingHoursMissionStructureId() {
        let appId = resource.data.applicationId;
        return appId != null && exists(/databases/$(database)/documents/applications/$(appId)) &&
               get(/databases/$(database)/documents/applications/$(appId)).data.missionId != null &&
               exists(/databases/$(database)/documents/missions/$(get(/databases/$(database)/documents/applications/$(appId)).data.missionId)) ?
               get(/databases/$(database)/documents/missions/$(get(/databases/$(database)/documents/applications/$(appId)).data.missionId)).data.structureId : null;
      }
      function canReadWorkingHours() {
        let sid = getWorkingHoursMissionStructureId();
        return sid != null && (hasPermissionOrStructureFallback('mission', 'read', sid) || hasPermissionOrStructureFallback('tresorerie', 'read', sid));
      }
      function canWriteWorkingHours() {
        let sid = getWorkingHoursMissionStructureId();
        return sid != null && hasPermissionOrStructureFallback('mission', 'write', sid);
      }
      function canCreateWorkingHours() {
        let reqData = request.resource.data;
        let appId = reqData.applicationId;
        return appId != null && exists(/databases/$(database)/documents/applications/$(appId)) &&
               get(/databases/$(database)/documents/applications/$(appId)).data.missionId != null &&
               exists(/databases/$(database)/documents/missions/$(get(/databases/$(database)/documents/applications/$(appId)).data.missionId)) &&
               hasPermissionOrStructureFallback('mission', 'write', get(/databases/$(database)/documents/missions/$(get(/databases/$(database)/documents/applications/$(appId)).data.missionId)).data.structureId);
      }
      allow read: if isAuthenticated() && (isSuperAdmin() || canReadWorkingHours());
      allow create: if isAuthenticated() && (isSuperAdmin() || canCreateWorkingHours());
      allow update: if isAuthenticated() && (isSuperAdmin() || canWriteWorkingHours());
      allow delete: if isAuthenticated() && (isSuperAdmin() || canWriteWorkingHours());
    }

    // =========================================================================
    // RÈGLES POUR LES AVENANTS
    // =========================================================================
    
    match /amendments/{amendmentId} {
      function getAmendmentMissionStructureId() {
        let amendmentData = resource.data;
        return exists(/databases/$(database)/documents/missions/$(amendmentData.missionId)) ?
               get(/databases/$(database)/documents/missions/$(amendmentData.missionId)).data.structureId : null;
      }
      function canReadAmendment() {
        return getAmendmentMissionStructureId() != null &&
               hasPermissionOrStructureFallback('mission', 'read', getAmendmentMissionStructureId());
      }
      function canWriteAmendment() {
        return getAmendmentMissionStructureId() != null &&
               hasPermissionOrStructureFallback('mission', 'write', getAmendmentMissionStructureId());
      }
      allow read: if isAuthenticated() && (isSuperAdmin() || canReadAmendment());
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.resource.data.missionId != null && exists(/databases/$(database)/documents/missions/$(request.resource.data.missionId)) &&
         hasPermissionOrStructureFallback('mission', 'write', get(/databases/$(database)/documents/missions/$(request.resource.data.missionId)).data.structureId))
      );
      allow update: if isAuthenticated() && (isSuperAdmin() || canWriteAmendment());
      allow delete: if isAuthenticated() && (isSuperAdmin() || canWriteAmendment());
    }

    // =========================================================================
    // RÈGLES POUR LES DOCUMENTS GÉNÉRÉS (COLLECTION PRINCIPALE)
    // Tout utilisateur authentifié peut lire/écrire pour la génération de documents.
    // =========================================================================
    
    match /generatedDocuments/{documentId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // RÈGLES POUR LES CONTACTS
    // =========================================================================
    
    match /contacts/{contactId} {
      function canAccessContact() {
        let userData = getUserData();
        let contactData = resource.data;
        return isSuperAdmin() ||
               (
                 userData != null && 
                 userData.status in ['admin', 'membre'] &&
                 contactData.structureId == userData.structureId
               ) ||
               (
                 contactData.companyId != null &&
                 exists(/databases/$(database)/documents/companies/$(contactData.companyId)) &&
                 (
                   isSuperAdmin() ||
                   (
                     userData != null && 
                     userData.status in ['admin', 'membre'] &&
                     get(/databases/$(database)/documents/companies/$(contactData.companyId)).data.structureId == userData.structureId
                   )
                 )
               ) ||
               (
                 userData != null &&
                 userData.status == 'entreprise' &&
                 contactData.userId == request.auth.uid
               ) ||
               (
                 userData != null &&
                 userData.status == 'entreprise' &&
                 userData.companyId != null &&
                 contactData.companyId == userData.companyId
               );
      }
      
      allow read: if isAuthenticated() && canAccessContact();
      
      allow create: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          request.resource.data.structureId == getUserData().structureId &&
          getUserData().status in ['membre', 'admin']
        )
      );
      
      allow update: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          resource.data.structureId == getUserData().structureId &&
          getUserData().status in ['membre', 'admin']
        )
      );
      
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || 
        (
          resource.data.structureId == getUserData().structureId &&
          getUserData().status in ['membre', 'admin']
        )
      );
    }

    match /contactAccess/{contactAccessId} {
      function canAccessContactAccess() {
        let userData = getUserData();
        return isSuperAdmin() ||
               (
                 userData != null && 
                 userData.status in ['admin', 'membre'] &&
                 exists(/databases/$(database)/documents/contacts/$(contactAccessId)) &&
                 get(/databases/$(database)/documents/contacts/$(contactAccessId)).data.structureId == userData.structureId
               ) ||
               (
                 userData != null && 
                 userData.status == 'entreprise' &&
                 exists(/databases/$(database)/documents/contacts/$(contactAccessId)) &&
                 get(/databases/$(database)/documents/contacts/$(contactAccessId)).data.userId == request.auth.uid
               );
      }
      
      allow read: if isAuthenticated() && canAccessContactAccess();
      
      allow write: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          getUserData() != null &&
          getUserData().status in ['admin', 'membre'] &&
          exists(/databases/$(database)/documents/contacts/$(contactAccessId)) &&
          get(/databases/$(database)/documents/contacts/$(contactAccessId)).data.structureId == getUserData().structureId
        )
      );
    }

    // =========================================================================
    // RÈGLES POUR AMBASSADOR SETTINGS (entreprise sélectionnée par structure)
    // =========================================================================
    
    match /ambassadorSettings/{structureId} {
      function canAccessAmbassadorSettings() {
        let userData = getUserData();
        return userData != null &&
               userData.structureId == structureId &&
               (userData.status == 'admin' || userData.status == 'membre' || userData.status == 'superadmin' ||
                userData.role == 'admin' || userData.role == 'superadmin');
      }
      allow read, write: if isAuthenticated() && (isSuperAdmin() || canAccessAmbassadorSettings());
    }

    // Favoris missions par utilisateur (Mission, Etude, Projet)
    match /userFavorites/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // RÈGLE PAR DÉFAUT - REFUSER TOUT ACCÈS NON EXPLICITEMENT AUTORISÉ
    // =========================================================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
