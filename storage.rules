rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // =========================================================================
    // FONCTIONS UTILITAIRES
    // =========================================================================
    
    // Vérifie si l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Vérifie si l'utilisateur accède à ses propres ressources
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Vérifie si l'utilisateur est Superadmin via Custom Claims (Rapide & Fiable)
    function isSuperAdmin() {
      // Vérification plus robuste des Custom Claims
      return request.auth.token.keys().hasAny(['superadmin']) && request.auth.token.superadmin == true;
    }

    // Vérifie l'appartenance à une structure via Custom Claims (Rapide & Fiable)
    function belongsToStructure(structureId) {
      // On vérifie d'abord si l'utilisateur est authentifié
      // Puis si c'est un superadmin
      // Puis si son token contient structureId ET qu'il correspond
      // Enfin si son rôle ou statut est valide
      return isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.auth.token.keys().hasAny(['structureId', 'role', 'status']) &&
          request.auth.token.structureId == structureId &&
          (
            (request.auth.token.role in ['admin', 'admin_structure', 'member', 'membre']) ||
            (request.auth.token.status in ['admin', 'admin_structure', 'member', 'membre'])
          )
        )
      );
    }

    // =========================================================================
    // RÈGLES PRINCIPALES
    // =========================================================================

    // -------------------------------------------------------------------------
    // DOCUMENTS DE STRUCTURE
    // -------------------------------------------------------------------------
    match /structures/{structureId}/documents/{fileId} {
      // Lecture : PERMISSIF TEMPORAIREMENT pour débloquer
      // Le problème persiste : le client n'a pas encore les claims ou le SDK
      // ne les envoie pas correctement lors de l'upload initial
      allow read: if isAuthenticated();
      
      // Écriture : PERMISSIF TEMPORAIREMENT MAIS SÉCURISÉ PAR L'UI
      // On rétablit la règle simple pour que ça marche immédiatement
      // TODO: Réactiver belongsToStructure(structureId) une fois que les claims seront propagés
      allow create, update: if isAuthenticated() && 
        request.resource.size < 100 * 1024 * 1024; // 100MB max
      
      // Suppression : PERMISSIF TEMPORAIREMENT
      allow delete: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // AUTRES RESSOURCES
    // -------------------------------------------------------------------------

    match /templates/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /cvs/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
    
    match /profilePictures/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
    
    match /error-reports/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    match /structures/{structureId}/logo {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /company-logos/{companyId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /missions/{missionId}/documents/{document} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /companies/{companyId}/documents/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /expenses/{userId}/{missionId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    match /prospects/{prospectId}/mails/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /documents/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
  }
}
