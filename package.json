{
  "name": "js-saas-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3006 --force",
    "start": "react-scripts start",
    "build": "node --max-old-space-size=8192 ./node_modules/.bin/vite build",
    "build:staging": "npm run check:env -- --env=.env.staging && node --max-old-space-size=8192 ./node_modules/.bin/vite build --mode staging",
    "build:extension": "npm run generate-icon && node scripts/download-firebase.js && vite build --config vite.config.extension.js && node scripts/build-extension.js",
    "build:extension-zip": "node scripts/build-extension.js && node scripts/build-extension-zip.js",
    "build:extension-folder": "node scripts/build-extension-folder.js",
    "build:extension-all": "npm run build:extension-zip && npm run build:extension-folder",
    "fix:extension": "node scripts/fix-extension.js",
    "watch:extension": "node scripts/watch-extension.js",
    "generate-icon": "node scripts/generate-icon.js",
    "preview": "vite preview",
    "check:env": "node scripts/check-env.js",
    "clean": "rm -rf node_modules/.vite node_modules/.cache && npm install",
    "//lint-max-warnings": "1890 = baseline post onboarding-wizard-lotb integration (2026-08-11). Ratchet DOWN only; do not raise.",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 1890",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ci": "node scripts/check-typecheck-ceiling.mjs",
    "lint:functions": "npm --prefix functions run lint",
    "lint:functions:ci": "node scripts/check-functions-lint-ceiling.mjs",
    "test": "vitest run && vitest run --config vitest.stripe.config.js",
    "test:watch": "vitest",
    "test:stripe": "vitest run --config vitest.stripe.config.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-jsaas-rules \"vitest run --config vitest.rules.config.js\"",
    "test:quota": "firebase emulators:exec --only firestore --project demo-jsaas-quota \"vitest run --config vitest.quota.config.js\"",
    "build:analyze": "ANALYZE=true npm run build",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "prebuild": "node scripts/build-extension.js && node scripts/build-extension-zip.js",
    "deploy": "node scripts/confirm-prod-deploy.mjs && npm run check:env && npm run build && firebase deploy",
    "deploy:hosting": "node scripts/confirm-prod-deploy.mjs && npm run check:env && npm run build && firebase deploy --only hosting",
    "deploy:staging": "firebase use staging && npm run build:staging && firebase deploy",
    "deploy:staging:rules": "firebase use staging && firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:staging:functions": "firebase use staging && firebase deploy --only functions",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:firestore": "firebase deploy --only firestore",
    "deploy:storage": "firebase deploy --only storage",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:rules-only": "firebase deploy --only firestore:rules",
    "deploy:decrypt-function": "firebase deploy --only functions:decryptUserDataForStructure",
    "deploy:verify-2fa": "firebase deploy --only functions:verifyTwoFactorCode",
    "deploy:security": "node scripts/confirm-prod-deploy.mjs && firebase deploy --only firestore:rules,storage,functions",
    "migrate:stripe-secrets": "npm --prefix functions run migrate:stripe-secrets",
    "migrate:stripe-secrets:dry-run": "npm --prefix functions run migrate:stripe-secrets:dry-run",
    "backfill:quota": "npm --prefix functions run backfill:quota",
    "backfill:quota:dry-run": "npm --prefix functions run backfill:quota:dry-run",
    "deploy:security-failed": "firebase deploy --only functions:saveStructureStripeSecret,functions:encryptUserOnWrite",
    "deploy:saveStructureStripeSecret": "firebase deploy --only functions:saveStructureStripeSecret",
    "deploy:encryptUserOnWrite": "firebase deploy --only functions:encryptUserOnWrite",
    "deploy:security-failed:staggered": "bash scripts/deploy-security-failed-staggered.sh",
    "ios:setup": "npx react-native-cli init JSConnectiOS --template react-native-template-typescript",
    "ios:run": "cd JSConnectiOS && npx react-native run-ios",
    "ios:build": "cd JSConnectiOS && npx react-native run-ios --configuration Release",
    "capacitor:init": "npx @capacitor/cli init",
    "capacitor:add-ios": "npx @capacitor/cli add ios",
    "capacitor:build": "npm run build && npx @capacitor/cli copy",
    "capacitor:sync": "npx @capacitor/cli sync",
    "capacitor:open-ios": "npx @capacitor/cli open ios"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emailjs/browser": "^4.4.1",
    "@emotion/react": "11.11.1",
    "@emotion/styled": "11.11.0",
    "@firebase/firestore": "^4.7.10",
    "@firebase/firestore-compat": "^0.3.45",
    "@fullcalendar/core": "^6.1.17",
    "@fullcalendar/daygrid": "^6.1.17",
    "@fullcalendar/interaction": "^6.1.17",
    "@fullcalendar/react": "^6.1.17",
    "@fullcalendar/timegrid": "^6.1.17",
    "@mui/icons-material": "^5.14.0",
    "@mui/material": "5.14.0",
    "@mui/x-date-pickers": "5.0.20",
    "@react-google-maps/api": "^2.20.8",
    "@react-pdf/renderer": "^4.3.0",
    "@stripe/stripe-js": "^7.1.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/jszip": "^3.4.0",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/uuid": "^10.0.0",
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.16.1",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "2.30.0",
    "docx-preview": "^0.3.6",
    "docxtemplater": "^3.66.3",
    "firebase": "^11.5.0",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.10.3",
    "jspdf": "^3.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.503.0",
    "mammoth": "^1.10.0",
    "notistack": "^3.0.2",
    "nth-check": "^2.1.1",
    "papaparse": "^5.5.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.8.69",
    "pizzip": "^3.2.0",
    "pptxtemplater": "^1.0.5",
    "qrcode.react": "^4.2.0",
    "react": "18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "18.2.0",
    "react-draggable": "^4.4.6",
    "react-dropzone": "^14.3.8",
    "react-pdf": "^9.2.1",
    "react-router-dom": "6.14.1",
    "react-to-pdf": "^2.0.1",
    "slate": "^0.117.2",
    "slate-react": "^0.117.2",
    "tailwind-merge": "^3.2.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/ios": "^5.0.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "18.2.14",
    "@types/react-dom": "18.2.6",
    "@typescript-eslint/eslint-plugin": "5.61.0",
    "@typescript-eslint/parser": "5.61.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.23",
    "chokidar": "^4.0.3",
    "esbuild": "^0.25.1",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.16",
    "firebase-admin": "^11.11.1",
    "firebase-functions": "^6.6.0",
    "firebase-tools": "^15.25.1",
    "fs-extra": "^11.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^5.14.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.19",
    "terser": "^5.43.1",
    "typescript": "^5.4.5",
    "vite": "^6.2.3",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "@firebase/app": "^0.14.1"
  },
  "resolutions": {
    "@firebase/app": "^0.14.1"
  }
}
