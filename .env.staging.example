# Firebase (obligatoire) — projet js-connect-staging
# Remplir VITE_FIREBASE_API_KEY depuis la console si besoin (local : .env.staging)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=js-connect-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=js-connect-staging
VITE_FIREBASE_STORAGE_BUCKET=js-connect-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=635540305122
VITE_FIREBASE_APP_ID=1:635540305122:web:a6658ad5546785fe441abb

# URL publique de l'app staging
VITE_APP_URL=https://js-connect-staging.web.app

# EmailJS — LAISSER VIDE en staging.
# Le staging ne doit envoyer aucun email, pour éviter d'écrire à de vrais contacts pendant les tests.
VITE_EMAILJS_USER_ID=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID_GENERIC=
VITE_EMAILJS_TEMPLATE_ID_MEMBER_INVITE=
VITE_EMAILJS_TEMPLATE_ID_SIGNATURE=
VITE_EMAILJS_TEMPLATE_ID_AMBASSADOR=
VITE_EMAILJS_TEMPLATE_ID_AMBASSADOR_EVENT_ANNOUNCEMENT=
VITE_EMAILJS_TEMPLATE_ID_STRUCTURE_PROPOSAL=
VITE_EMAILJS_TEMPLATE_DEM1=

# Cloud Functions — callables en us-central1 (Firestore/Storage restent europe-west1)
VITE_FUNCTIONS_REGION=us-central1
VITE_FUNCTIONS_BASE_URL=https://us-central1-js-connect-staging.cloudfunctions.net

# Optionnel
VITE_GA_MEASUREMENT_ID=
VITE_DEBUG_FIREBASE=false
VITE_DEBUG_AUTH=false
