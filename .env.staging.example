# Firebase (obligatoire) — projet jsaas-staging
# Remplir API_KEY, MESSAGING_SENDER_ID et APP_ID depuis la console Firebase
# (Paramètres du projet → Vos applications → JS Connect Staging)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=jsaas-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jsaas-staging
VITE_FIREBASE_STORAGE_BUCKET=jsaas-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL publique de l'app staging
VITE_APP_URL=https://jsaas-staging.web.app

# EmailJS — LAISSER VIDE en staging.
# Le staging ne doit envoyer aucun email, pour éviter d'écrire à de vrais contacts pendant les tests.
VITE_EMAILJS_USER_ID=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID_GENERIC=
VITE_EMAILJS_TEMPLATE_ID_MEMBER_INVITE=
VITE_EMAILJS_TEMPLATE_ID_SIGNATURE=
VITE_EMAILJS_TEMPLATE_ID_AMBASSADOR=
VITE_EMAILJS_TEMPLATE_ID_AMBASSADOR_EVENT_ANNOUNCEMENT=
VITE_EMAILJS_TEMPLATE_ID_STRUCTURE_PROPOSAL=
VITE_EMAILJS_TEMPLATE_DEM1=

# Cloud Functions — région europe-west1 sur jsaas-staging
VITE_FUNCTIONS_REGION=europe-west1
VITE_FUNCTIONS_BASE_URL=https://europe-west1-jsaas-staging.cloudfunctions.net

# Optionnel
VITE_GA_MEASUREMENT_ID=
VITE_DEBUG_FIREBASE=false
VITE_DEBUG_AUTH=false
