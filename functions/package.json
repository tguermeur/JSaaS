{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "npm run build && firebase emulators:start --only functions",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "node lib/index.js",
    "deploy": "firebase deploy --only functions",
    "migrate:stripe-secrets": "node scripts/migrate-stripe-secrets.js",
    "migrate:stripe-secrets:dry-run": "node scripts/migrate-stripe-secrets.js --dry-run",
    "deploy:security-failed": "firebase deploy --only functions:saveStructureStripeSecret,functions:encryptUserOnWrite",
    "deploy:failed-quota": "firebase deploy --only functions:decryptUserDataForStructure,functions:createCheckoutSession",
    "deploy:entreprise-ambassador": "firebase deploy --only functions:decryptUserDataForStructure,functions:decryptContactDataForStructure,functions:decryptOwnUserData,functions:decryptOwnCompanyData",
    "deploy:scoring": "firebase deploy --only functions:analyzePastClients,functions:generateContactMessage,functions:computeProspectScores,functions:getRelanceSuggestions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@stripe/stripe-js": "^7.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "firebase-admin": "^11.11.1",
    "firebase-functions": "^6.3.2",
    "pdf-lib": "^1.17.1",
    "speakeasy": "^2.0.0",
    "stripe": "^14.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/speakeasy": "^2.0.10",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
