# Firebase (obligatoire)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL publique de l'app (liens email, magic link superadmin)
VITE_APP_URL=

# EmailJS (envoi depuis le navigateur) — max 6 templates
VITE_EMAILJS_USER_ID=
VITE_EMAILJS_SERVICE_ID=
# Slot 1 : notifs + invite + proposition + prospection
VITE_EMAILJS_TEMPLATE_ID_GENERIC=
# Alias optionnel (même ID que GENERIC)
VITE_EMAILJS_TEMPLATE_ID_MEMBER_INVITE=
# Slot 2 : signatures
VITE_EMAILJS_TEMPLATE_ID_SIGNATURE=
# Slot 3–5 : spécialisés
VITE_EMAILJS_TEMPLATE_ID_AMBASSADOR=
VITE_EMAILJS_TEMPLATE_ID_AMBASSADOR_EVENT_ANNOUNCEMENT=
# Anciens (dépréciés — fallback seulement)
VITE_EMAILJS_TEMPLATE_ID_STRUCTURE_PROPOSAL=
VITE_EMAILJS_TEMPLATE_DEM1=

# Optionnel
VITE_GA_MEASUREMENT_ID=
VITE_DEBUG_FIREBASE=false
VITE_DEBUG_AUTH=false
